# Copy this file to vars.env and fill in the values. vars.env is ignored by git.
# No spaces and no quotes around values (the file is read by hurl and by run.sh).

# Run mode:
#   safe : instance where data must NOT be created (production). Files with _WRITE in their name are skipped.
#   full : dedicated test instance. All files run, including the ones creating data / sending emails.
run_mode=safe

# Host serving the template website (no trailing slash, no /htdocs). Ex: https://marketplace.local
base_url=https://marketplace.local

# Optional HTTP basic auth in front of the site (htaccess). Leave both empty if there is none.
basic_user=
basic_password=

# Id of a product with a price > 0, used by the payment tests
paid_product_id=214

# Ids of two existing products (modules) of the site, used by the cart tests
cart_product_id_1=182
cart_product_id_2=333

# Test accounts of the website (customer accounts = email + password of the template login)
customer_email=test_customer@example.com
customer_password=change_me
